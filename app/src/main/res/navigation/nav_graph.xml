<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nameFragment">

    <fragment
        android:id="@+id/nameFragment"
        android:name="com.example.testkotlin.NameFragment"
        android:label="Имя">
        <action
            android:id="@+id/action_nameFragment_to_testFragment"
            app:destination="@id/testFragment" />
    </fragment>

    <fragment
        android:id="@+id/testFragment"
        android:name="com.example.testkotlin.TestFragment"
        android:label="Test">
        <action
            android:id="@+id/action_testFragment_to_resultFragment"
            app:destination="@id/resultFragment">
            <!-- Передаём аргументы -->
            <argument
                android:name="user_name"
                app:argType="string" />
            <argument
                android:name="score"
                app:argType="integer" />
            <argument
                android:name="total_questions"
                app:argType="integer" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.example.testkotlin.ResultFragment"
        android:label="Results">
        <action
            android:id="@+id/action_resultFragment_to_nameFragment"
            app:destination="@id/nameFragment" />
    </fragment>
</navigation>